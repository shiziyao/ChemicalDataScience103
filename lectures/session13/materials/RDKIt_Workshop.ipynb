   "source": [
    "from rdkit.Chem import rdFingerprintGenerator, DataStructs\n",
    "\n",
    "# use e.g. the morgan FPG: mfpgen = rdFingerprintGenerator.GetMorganGenerator(radius=2,fpSize=2048)\n",
    "def mol2fp(smiles):\n",
    "    mol = Chem.MolFromSmiles(smiles)\n",
    "    mfpgen = rdFingerprintGenerator.GetMorganGenerator(radius=2,fpSize=2048) #radius=2,fpSize=2048\n",
    "    fp = mfpgen.GetFingerprint(mol)\n",
    "    return fp\n",
    "\n",
    "df[\"fingerprint\"] = df[\"SMILES\"].apply(mol2fp)\n",
    "smiles_list = df[\"SMILES\"].to_list()\n",
    "# smiles_list"
   ]
  },
